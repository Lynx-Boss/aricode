// aricode - Struct Pattern with for loops
// Clean struct-like data structures using arrays and accessor functions
// Demonstrates idiomatic aricode data modeling

// ---- Vector2D: { x: i32, y: i32 } ----
fn vec2_new(x: i32, y: i32) -> i32 {
    let v: i32 = arr_new(2);
    arr_set(v, 0, x);
    arr_set(v, 1, y);
    return v;
}
fn vec2_x(v: i32) -> i32 { return arr_get(v, 0); }
fn vec2_y(v: i32) -> i32 { return arr_get(v, 1); }

fn vec2_add(a: i32, b: i32) -> i32 {
    return vec2_new(vec2_x(a) + vec2_x(b), vec2_y(a) + vec2_y(b));
}

fn vec2_dot(a: i32, b: i32) -> i32 {
    return vec2_x(a) * vec2_x(b) + vec2_y(a) * vec2_y(b);
}

fn vec2_print(v: i32) -> i32 {
    print_str("(");
    print_int(vec2_x(v));
    print_str(",");
    print_int(vec2_y(v));
    print_str(")");
    return 0;
}

// ---- Collection of vectors ----
fn main() -> i32 {
    print_str("=== Vector Collection ===");

    // Create 4 vectors
    let vecs: i32 = arr_new(4);
    arr_set(vecs, 0, vec2_new(1, 2));
    arr_set(vecs, 1, vec2_new(3, 4));
    arr_set(vecs, 2, vec2_new(5, 6));
    arr_set(vecs, 3, vec2_new(7, 8));

    // Print all vectors
    print_str("Vectors:");
    for (let i: i32 = 0; i < 4; i = i + 1) {
        let v: i32 = arr_get(vecs, i);
        vec2_print(v);
    }

    // Sum all vectors
    let sum: i32 = vec2_new(0, 0);
    for (let i: i32 = 0; i < 4; i = i + 1) {
        sum = vec2_add(sum, arr_get(vecs, i));
    }
    print_str("Sum:");
    vec2_print(sum);

    // Dot product of first two
    let d: i32 = vec2_dot(arr_get(vecs, 0), arr_get(vecs, 1));
    print_str("Dot (v0,v1):");
    print_int(d);

    return 0;
}
