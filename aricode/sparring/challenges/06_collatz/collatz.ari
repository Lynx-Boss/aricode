// aricode - Challenge 06: Collatz Conjecture
// Compute the number of steps for 871 to reach 1 = 178 steps
// The Collatz conjecture (1937) remains UNSOLVED.
// Erdos: "Mathematics is not yet ready for such problems."
//
// ITERATIVE with strength reduction:
//   n % 2  -> n & 1  (bitwise AND)
//   n / 2  -> n >> 1 (shift right)

fn collatz_steps(n: i32) -> i32 {
    let steps: i32 = 0;
    while (n > 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps = steps + 1;
    }
    return steps;
}

fn main() -> i32 {
    return collatz_steps(871);
}
