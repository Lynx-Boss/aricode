// aricode - Challenge 07: Mersenne Prime Verification
// Verify M31 = 2^31 - 1 = 2,147,483,647 is prime
// Return 1 if prime, 0 if not (exit code)
//
// ITERATIVE with strength reduction:
//   n % 2  -> n & 1  (bitwise AND, 1 instruction)
//   n / 2  -> n >> 1 (arithmetic shift, 1 instruction)
// ~23,170 divisors tested in a tight while loop.

fn is_prime(n: i32) -> i32 {
    if (n % 2 == 0) {
        return 0;
    }
    let d: i32 = 3;
    while (n / d >= d) {
        if (n % d == 0) {
            return 0;
        }
        d = d + 2;
    }
    return 1;
}

fn main() -> i32 {
    return is_prime(2147483647);
}
