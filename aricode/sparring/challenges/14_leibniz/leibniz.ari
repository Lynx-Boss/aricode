// aricode - Challenge 14: Leibniz Pi Approximation
// pi/4 = 1 - 1/3 + 1/5 - 1/7 + ... (10000 terms)
// Return floor(pi * 50) = 157
// Tests: f64 float arithmetic in tight loop, SSE2

fn main() -> i32 {
    let sum: f64 = 0.0;
    let sign: f64 = 1.0;
    let denom: f64 = 1.0;
    let two: f64 = 2.0;
    let i: i32 = 0;
    while (i < 10000) {
        sum = sum + sign / denom;
        sign = 0.0 - sign;
        denom = denom + two;
        i = i + 1;
    }
    let pi: f64 = sum * 4.0;
    let result: f64 = pi * 50.0;
    return float_to_int(result);
}
