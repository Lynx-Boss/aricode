fn main() -> i32 {
    // Build a known 2-row table (max_seq=2, d_head=4):
    //   row 0 (pos=0):  [cos(0), sin(0), cos(0), sin(0)]   = [1, 0, 1, 0]
    //   row 1 (pos=1):  [cos(π/4), sin(π/4), cos(π/4), sin(π/4)]
    //                   = [√2/2, √2/2, √2/2, √2/2]
    let table: i32 = arr_f32_new(8);
    arr_f32_set(table, 0, 1.0); arr_f32_set(table, 1, 0.0);  // pair 0: identity
    arr_f32_set(table, 2, 1.0); arr_f32_set(table, 3, 0.0);  // pair 1: identity
    arr_f32_set(table, 4, 0.7071067811865476); arr_f32_set(table, 5, 0.7071067811865476);  // pair 0 at pos=1: π/4
    arr_f32_set(table, 6, 0.7071067811865476); arr_f32_set(table, 7, 0.7071067811865476);  // pair 1 at pos=1: π/4

    // Vec at pos=0 — must be unchanged.
    let v: i32 = arr_f32_new(4);
    arr_f32_set(v, 0, 3.0); arr_f32_set(v, 1, 4.0);
    arr_f32_set(v, 2, 5.0); arr_f32_set(v, 3, 6.0);
    arr_f32_rope_apply_pairs(v, table, 0, 4);
    // Expected: 3, 4, 5, 6 (identity).
    print_f64(arr_f32_get(v, 0), 6);
    print_f64(arr_f32_get(v, 1), 6);
    print_f64(arr_f32_get(v, 2), 6);
    print_f64(arr_f32_get(v, 3), 6);

    // Reset, rotate at pos=1 (π/4 each pair).
    arr_f32_set(v, 0, 1.0); arr_f32_set(v, 1, 0.0);  // pair 0
    arr_f32_set(v, 2, 1.0); arr_f32_set(v, 3, 0.0);  // pair 1
    arr_f32_rope_apply_pairs(v, table, 1, 4);
    // Expected for pair (1, 0) rotated by π/4:
    //   (1*√2/2 - 0*√2/2, 1*√2/2 + 0*√2/2) = (0.7071, 0.7071)
    print_f64(arr_f32_get(v, 0), 6);
    print_f64(arr_f32_get(v, 1), 6);
    print_f64(arr_f32_get(v, 2), 6);
    print_f64(arr_f32_get(v, 3), 6);
    return 0;
}
